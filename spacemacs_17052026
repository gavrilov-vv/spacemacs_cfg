(defun dotspacemacs/user-init ()

  (setq configuration-layer--elpa-archives
        '(("melpa-cn" . "http://mirrors.cloud.tencent.com/elpa/melpa/")
          ("org-cn"   . "http://mirrors.cloud.tencent.com/elpa/org/")
          ("gnu-cn"   . "http://mirrors.cloud.tencent.com/elpa/gnu/")))


  (defun my-reload-dir-locals-for-all-buffer-in-this-directory ()
    "For every buffer with the same `default-directory` as the current buffer's, reload dir-locals."
    (interactive)
    (let ((dir default-directory))
      (dolist (buffer (buffer-list))
        (with-current-buffer buffer
          (when (equal default-directory dir)
            (my-reload-dir-locals-for-current-buffer))))))

  (add-hook 'emacs-lisp-mode-hook
            (defun enable-autoreload-for-dir-locals ()
              (when (and (buffer-file-name)
                         (equal dir-locals-file
                                (file-name-nondirectory (buffer-file-name))))
                (add-hook 'after-save-hook
                          'my-reload-dir-locals-for-all-buffer-in-this-directory
                          nil t))))


  ;; Увеличиваем порог GC до 100MB
  (setq gc-cons-threshold (* 100 1024 1024))
  (setq gc-cons-percentage 0.1)

  ;; Увеличиваем лимит чтения данных от LSP (4MB)
  (setq read-process-output-max (* 4 1024 1024))

  ;; Ускоряем работу файловой системы
  (setq auto-mode-case-fold nil)

  ;; Отключаем лишние проверки файлов
  (setq vc-handled-backends nil)

  ;; Ускоряем работу с большими файлами
  (setq large-file-warning-threshold (* 50 1024 1024))

  )

(defun dotspacemacs/user-config ()
  (require 'sqlite3)
  (require 'srefactor)
  (require 'dap-gdb-lldb)
  (require 'dap-cpptools)
  (require 'dap-lldb)

  (dap-gdb-lldb-setup)

  (global-unset-key (kbd "<f2>"))
  (global-unset-key (kbd "<f4>"))
  (global-unset-key (kbd "C-S"))
  ;; -------------------------- Привязки клавиш ----------------------------------

  ;; Показать контекстную справку
  (global-set-key (kbd "<S-f1>") 'lsp-ui-doc-glance)
  ;; Привязать F2 к переходу к определению через LSP
  (global-set-key (kbd "<f2>") 'lsp-find-definition)
  ;; Привязать F4 к переключению между заголовочным и исходным файлом
  (global-set-key (kbd "<f4>") 'ff-find-other-file)
  ;; Найти все ссылки
  (global-set-key (kbd "S-<f2>") 'lsp-find-references)
  ;; Запустить отладку
  (define-key evil-normal-state-map (kbd "<f5>") 'dap-debug)
  ;; Вкл/Выкл точку останова
  (define-key evil-normal-state-map (kbd "<f9>") 'dap-breakpoint-toggle)
  ;; На шаг вперед
  (define-key evil-normal-state-map (kbd "<f10>") 'dap-next)
  ;; Шаг внутрь
  (define-key evil-normal-state-map (kbd "<f11>") 'dap-step-in)

  ;; ;; Дополнительные полезные привязки для C++
  ;; (global-set-key (kbd "C-<f2>") 'lsp-find-implementation) ; Ctrl-F2 - найти реализацию
  ;; (global-set-key (kbd "M-<f2>") 'lsp-rename)              ; Alt-F2 - переименование
  ;; (global-set-key (kbd "S-<f4>") 'ff-find-other-file-other-window) ; в другом окне
  ;; (global-set-key (kbd "C-<f4>") 'projectile-find-other-file)      ; через projectile

  (use-package shift-text
    :ensure t
    :bind (("C-S-<down>" . shift-text-down)
           ("C-S-<up>" . shift-text-up)
           ("C-S-<right>" . shift-text-right)
           ("C-S-<left>" . shift-text-left)))

  (setq ff-always-try-to-create nil)

  ;; Проверка доступности SQLite в Emacs
  (defun check-sqlite-support ()
    (interactive)
    (if (fboundp 'sqlite-open)
        (message "✅ SQLite support is available")
      (message "❌ SQLite support NOT available - installing alternatives...")))

  (check-sqlite-support)

  (defun my/compilation-autoclose (buffer string)
    "Closes the compilation window if compilation is successful."
    (when (string-match-p "finished" string) ;; Check for successful completion message
      (message "Compilation successful: closing window.")
      (run-with-timer 3 nil 'delete-window (get-buffer-window buffer t))))

  (setq compilation-finish-functions '(my/compilation-autoclose))

  ;;-------------------------------------------
  (defun my/create-class-files (class-name)
    (interactive "sВведите имя класса: ")
    (let* ((file-name-base class-name)  ;; имя файла без изменений
           (class-name-corrected (concat (upcase (substring class-name 0 1))
                                         (substring class-name 1)))  ;; имя класса с заглавной
           (dir (file-name-directory (buffer-file-name)))
           (h-file (concat dir file-name-base ".h"))
           (cpp-file (concat dir file-name-base ".cpp"))
           (guard-name (upcase (concat file-name-base "_H"))))
      ;; Создаем и заполняем .h файл
      (find-file h-file)
      (insert (format "#ifndef %s\n#define %s\n\nclass %s {\npublic:\n   %s();\n   virtual ~%s();\n\nprivate:\n    \n};\n\n#endif // %s\n"
                      guard-name guard-name class-name-corrected class-name-corrected class-name-corrected guard-name))
      (save-buffer)
      ;; Создаем и заполняем .cpp файл
      (find-file cpp-file)
      (insert (format "#include \"%s.h\"\n\n%s::%s() {\n    \n}\n\n%s::~%s() {\n    \n}\n"
                      file-name-base class-name-corrected class-name-corrected class-name-corrected class-name-corrected))
      (save-buffer)
      ;; Возвращаемся в .h файл
      (find-file h-file)))

  (spacemacs/set-leader-keys "oc" 'my/create-class-files)

  (with-eval-after-load 'cc-mode
    (remove-hook 'c-mode-common-hook 'c-toggle-auto-newline))

  (setq c-basic-offset 4)
  (setq c-default-style "linux")

  (setq dap-auto-configure-features '(sessions locals controls tooltip))

  (with-eval-after-load 'lsp-mode
    ;; Безопасное добавление сниппетов к выдаче LSP
    (add-hook 'lsp-managed-mode-hook
              (lambda ()
                (when (bound-and-true-p company-backends)
                  (make-local-variable 'company-backends)
                  ;; Подмешиваем сниппеты к основному источнику lsp (company-capf)
                  (setq company-backends
                        (mapcar (lambda (backend)
                                  (if (and (eq backend 'company-capf)
                                           (not (and (listp backend) (memq 'company-yasnippet backend))))
                                      '(company-capf :with company-yasnippet)
                                    backend))
                                company-backends))))))


  )

